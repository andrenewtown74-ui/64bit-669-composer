     1                                  ; 64-Bit Windows Composer-669-Tracker (NASM, ohne CRT)
     2                                  ; Echtzeit-8-Kanal-Stereo-Mixer (WinMM Streaming) + Vollstaendiger Pattern-Editor
     3                                  ; Kompatibel mit lokaler Toolchain (nasm.exe + GoLink.exe)
     4                                  
     5                                  default rel
     6                                  bits 64
     7                                  
     8                                  ; Raster- und Fensterkonstanten (80x50 Zeichen a 12x12 Pixel)
     9                                  CHAR_W          equ 12
    10                                  CHAR_H          equ 12
    11                                  WIN_W           equ 960
    12                                  WIN_H           equ 600
    13                                  
    14                                  ; Tracker-Datenmodell
    15                                  MAX_PATS        equ 16
    16                                  PAT_ROWS        equ 32
    17                                  NUM_CH          equ 8
    18                                  CELL_SIZE       equ 4                   ; Byte 0=Note, 1=Inst, 2=Vol, 3=FX
    19                                  ROW_BYTES       equ NUM_CH * CELL_SIZE  ; 32 Byte pro Zeile
    20                                  PAT_BYTES       equ PAT_ROWS * ROW_BYTES; 1024 Byte pro Pattern
    21                                  VOICE_SIZE      equ 64
    22                                  
    23                                  ; Echtzeit-Audio-Streaming (44100 Hz, 16-Bit Stereo, 4 Puffer a 512 Frames)
    24                                  SAMPLE_RATE     equ 44100
    25                                  BUF_COUNT       equ 4
    26                                  BUF_FRAMES      equ 512
    27                                  BUF_BYTES       equ BUF_FRAMES * 4      ; 2048 Byte pro Puffer (~11,6 ms)
    28                                  TICKS_PER_TEMPO equ 1024                ; Tempo 5 = 5120 Samples/Zeile (~129 BPM)
    29                                  
    30                                  ; Windows-Konstanten
    31                                  WS_TRACKER      equ 0x10CA0000          ; OVERLAPPED|CAPTION|SYSMENU|MINIMIZEBOX|VISIBLE
    32                                  SRCCOPY         equ 0x00CC0020
    33                                  ETO_OPAQUE      equ 2
    34                                  TRANSPARENT     equ 1
    35                                  WHDR_DONE       equ 0x00000001
    36                                  IDC_ARROW       equ 32512
    37                                  
    38                                  WM_DESTROY      equ 0x0002
    39                                  WM_CLOSE        equ 0x0010
    40                                  WM_KEYDOWN      equ 0x0100
    41                                  
    42                                  VK_BACK         equ 0x08
    43                                  VK_TAB          equ 0x09
    44                                  VK_ESCAPE       equ 0x1B
    45                                  VK_SPACE        equ 0x20
    46                                  VK_PRIOR        equ 0x21                ; Bild Auf
    47                                  VK_NEXT         equ 0x22                ; Bild Ab
    48                                  VK_LEFT         equ 0x25
    49                                  VK_UP           equ 0x26
    50                                  VK_RIGHT        equ 0x27
    51                                  VK_DOWN         equ 0x28
    52                                  VK_DELETE       equ 0x2E
    53                                  VK_F1           equ 0x70
    54                                  VK_F2           equ 0x71
    55                                  VK_F3           equ 0x72
    56                                  VK_F4           equ 0x73
    57                                  VK_F5           equ 0x74
    58                                  VK_F6           equ 0x75
    59                                  VK_F7           equ 0x76
    60                                  VK_F8           equ 0x77
    61                                  VK_F9           equ 0x78
    62                                  VK_F10          equ 0x79
    63                                  
    64                                  ; Composer-669-Farbpalette (GDI COLORREF = 0x00BBGGRR)
    65                                  COL_BG          equ 0x00624222
    66                                  COL_BLACK       equ 0x00000000
    67                                  COL_BEAT        equ 0x00443424
    68                                  COL_PLAYROW     equ 0x00584814
    69                                  COL_EDITROW     equ 0x007A5018
    70                                  COL_CURSOR      equ 0x00F0D020          ; Helles Cyan-Gelb fuer aktives Edit-Feld
    71                                  COL_CYAN        equ 0x00F0F000
    72                                  COL_TEAL        equ 0x00B0B000
    73                                  COL_HDR_ON      equ 0x00786400
