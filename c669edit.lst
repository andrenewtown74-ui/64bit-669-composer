   275                                  ; Programmcode
   276                                  ; ============================================================================
   277                                  section .text
   278                                  global start
   279                                  
   280                                  ; Lineare Note (AL = 0..59) in 32-Bit-Phaseninkrement (EAX) wandeln
   281                                  note_to_inc:
   282 00000000 0FB6C0                      movzx eax, al
   283 00000003 31D2                        xor edx, edx
   284 00000005 B90C000000                  mov ecx, 12
   285 0000000A F7F1                        div ecx                     ; EAX = Oktave (0..4), EDX = Halbton (0..11)
   286 0000000C 89C1                        mov ecx, eax
   287 0000000E 4C8D05(64020000)            lea r8, [noteTbl]
   288 00000015 418B0490                    mov eax, [r8 + rdx*4]
   289 00000019 D3E0                        shl eax, cl
   290 0000001B C3                          ret
   291                                  
   292                                  ; EAX auf 16-Bit-Signed begrenzen
   293                                  clamp_s16:
   294 0000001C 3DFF7F0000                  cmp eax, 32767
   295 00000021 7E06                        jle .lo
   296 00000023 B8FF7F0000                  mov eax, 32767
   297 00000028 C3                          ret
   298                                  .lo:
   299 00000029 3D0180FFFF                  cmp eax, -32767
   300 0000002E 7D05                        jge .ok
   301 00000030 B80180FFFF                  mov eax, -32767
   302                                  .ok:
   303 00000035 C3                          ret
   304                                  
   305                                  ; Byte AL als 2 Hex-Zeichen nach [R8] schreiben
   306                                  fmt_hex2:
   307 00000036 488D15(31000000)            lea rdx, [hexTbl]
   308 0000003D 0FB6C8                      movzx ecx, al
   309 00000040 C1E904                      shr ecx, 4
   310 00000043 8A0C0A                      mov cl, [rdx + rcx]
   311 00000046 418808                      mov [r8], cl
   312 00000049 0FB6C8                      movzx ecx, al
   313 0000004C 83E10F                      and ecx, 15
   314 0000004F 8A0C0A                      mov cl, [rdx + rcx]
   315 00000052 41884801                    mov [r8 + 1], cl
   316 00000056 C3                          ret
   317                                  
   318                                  ; 20-Bit-Wert EAX als 5 Hex-Zeichen nach [R8] schreiben
   319                                  fmt_hex5:
   320 00000057 488D15(31000000)            lea rdx, [hexTbl]
   321 0000005E B904000000                  mov ecx, 4
   322                                  .l5:
   323 00000063 4189C1                      mov r9d, eax
   324 00000066 4183E10F                    and r9d, 15
   325 0000006A 468A0C0A                    mov r9b, [rdx + r9]
   326 0000006E 45880C08                    mov [r8 + rcx], r9b
   327 00000072 C1E804                      shr eax, 4
   328 00000075 FFC9                        dec ecx
   329 00000077 79EA                        jns .l5
   330 00000079 C3                          ret
   331                                  
   332                                  ; Zeiger auf Zelle (ECX=pat, EDX=row, R8D=ch) in RAX berechnen
   333                                  get_cell_ptr:
   334 0000007A 89C8                        mov eax, ecx
   335 0000007C C1E00A                      shl eax, 10                 ; pat * 1024
   336 0000007F 4189D1                      mov r9d, edx
   337 00000082 41C1E105                    shl r9d, 5                  ; row * 32
   338 00000086 4401C8                      add eax, r9d
   339 00000089 428D0480                    lea eax, [rax + r8*4]       ; + ch * 4
   340 0000008D 4C8D0D(78080000)            lea r9, [patterns]
   341 00000094 4C01C8                      add rax, r9
   342 00000097 C3                          ret
   343                                  
   344                                  ; Rechteck fuellen: ECX=x, EDX=y, R8D=w, R9D=h, R10D=COLORREF
   345                                  fill_rect:
   346 00000098 4883EC48                    sub rsp, 0x48
   347 0000009C 890D(80000000)              mov [tmpRect + 0], ecx
   348 000000A2 8915(84000000)              mov [tmpRect + 4], edx
   349 000000A8 4401C1                      add ecx, r8d
   350 000000AB 4401CA                      add edx, r9d
   351 000000AE 890D(88000000)              mov [tmpRect + 8], ecx
   352 000000B4 8915(8C000000)              mov [tmpRect + 12], edx
   353                                  
   354 000000BA 488B0D(18000000)            mov rcx, [memDC]
   355 000000C1 4489D2                      mov edx, r10d
   356 000000C4 E8(00000000)                call SetBkColor
   357                                  
   358 000000C9 488B0D(18000000)            mov rcx, [memDC]
   359 000000D0 31D2                        xor edx, edx
   360 000000D2 4531C0                      xor r8d, r8d
   361 000000D5 41B902000000                mov r9d, ETO_OPAQUE
   362 000000DB 488D05(80000000)            lea rax, [tmpRect]
   363 000000E2 4889442420                  mov [rsp + 0x20], rax
   364 000000E7 48C744242800000000          mov qword [rsp + 0x28], 0
   365 000000F0 48C744243000000000          mov qword [rsp + 0x30], 0
   366 000000F9 48C744243800000000          mov qword [rsp + 0x38], 0
   367 00000102 E8(00000000)                call ExtTextOutA
   368 00000107 4883C448                    add rsp, 0x48
   369 0000010B C3                          ret
   370                                  
   371                                  ; Text im 12x12-Raster zeichnen: ECX=Spalte, EDX=Zeile, R8=Ptr, R9D=Len, R10D=Farbe
   372                                  draw_text:
   373 0000010C 4883EC68                    sub rsp, 0x68
   374 00000110 6BC90C                      imul ecx, CHAR_W
   375 00000113 6BD20C                      imul edx, CHAR_H
   376 00000116 894C2440                    mov [rsp + 0x40], ecx
   377 0000011A 89542444                    mov [rsp + 0x44], edx
   378 0000011E 4C89442448                  mov [rsp + 0x48], r8
   379 00000123 44894C2450                  mov [rsp + 0x50], r9d
   380                                  
   381 00000128 488B0D(18000000)            mov rcx, [memDC]
   382 0000012F 4489D2                      mov edx, r10d
   383 00000132 E8(00000000)                call SetTextColor
   384                                  
   385 00000137 488B0D(18000000)            mov rcx, [memDC]
   386 0000013E 8B542440                    mov edx, [rsp + 0x40]
   387 00000142 448B442444                  mov r8d, [rsp + 0x44]
   388 00000147 4531C9                      xor r9d, r9d
   389 0000014A 48C744242000000000          mov qword [rsp + 0x20], 0
